<style>
    /* Custom Scrollbar for a cleaner look */
    .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: #f1f1f1; 
        border-radius: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #c1c1c1; 
        border-radius: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: #a8a8a8; 
    }

    /* Transition for page changes */
    .page-content {
        animation: fadeIn 0.3s ease-in-out;
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Active Nav Link Styling */
    .nav-link.active {
        background-color: #f0fdf4; /* green-50 */
        color: #16a34a; /* primary / green-600 */
        border-right: 3px solid #16a34a;
    }

    /* Dark Mode overrides (Basic implementation) */
    html.dark body {
        background-color: #0f172a;
        color: #e2e8f0;
    }
    html.dark .bg-white {
        background-color: #1e293b;
    }
    html.dark .bg-gray-50 {
        background-color: #0f172a;
    }
    html.dark .text-gray-900, html.dark .text-gray-800 {
        color: #f8fafc;
    }
    html.dark .text-gray-700, html.dark .text-gray-600, html.dark .text-gray-500 {
        color: #cbd5e1;
    }
    html.dark .border-gray-100, html.dark .border-gray-200, html.dark .border-gray-300 {
        border-color: #334155;
    }
    html.dark input, html.dark select, html.dark textarea {
        background-color: #0f172a;
        border-color: #334155;
        color: #f8fafc;
    }
    
    /* Hide input number arrows */
    input[type=number]::-webkit-inner-spin-button, 
    input[type=number]::-webkit-outer-spin-button { 
        -webkit-appearance: none; 
        margin: 0; 
    }
    input[type=number] {
        -moz-appearance: textfield;
    }
</style>
